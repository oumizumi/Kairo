# Supabase — Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# uOttawa Synto session cookie
# How to get it:
#   1. Log in at https://uottawa.syntosolution.com
#   2. Open DevTools → Application → Cookies → uottawa.syntosolution.com
#   3. Copy the full cookie string (all key=value pairs separated by "; ")
SYNTO_COOKIE=your_cookie_string_here
